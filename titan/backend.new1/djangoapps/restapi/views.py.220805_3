                '''.format(id=id)
                cur.execute(sql)
                rows = dictfetchall(cur)
                print('INFO old app ->' + id + ' 의' + 'NULL 줄수 :'+ str(len(rows)) + ' 동시접속 설정수 :' + simultaneous_use)
