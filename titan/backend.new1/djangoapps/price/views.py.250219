#pushplus 알림
def send_pushplus_notification(title, content):
    url = 'http://www.pushplus.plus/send'
    token = 'f15a46f5e2aa4a4da92f6ec17ad53362'
    data = {
        "token": token,
        "title": title,
        "content": content
    }
    response = requests.post(url, json=data)
    return response.json()


