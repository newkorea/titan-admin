<%! from django.utils.translation import ugettext as _ %>
<%inherit file="base.html"/>

<%block name="css">
</%block>

<%block name="content">
<!--body content wrap start-->
<div class="main">

    <!--hero section start-->
    <section class="hero-section ptb-100 background-img"
             style="background: url('/static/new/img/hero-bg-1.jpg')no-repeat center center / cover; padding-bottom: 30px !important;">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-9 col-lg-7">
                    <div class="page-header-content text-white text-center pt-sm-5 pt-md-5 pt-lg-0">
                        <h1 class="text-white mb-0">${_('Payment')}</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--hero section end-->

    <!--customer review section start-->
    <section class="customer-review-section gray-light-bg ptb-50">
        <div class="container">

            <div class="payment-tip">
                <div>
                  * ${_('Concurrent Access means the number of devices available to log in at the same time')}
                </div>
                <div>
                  * ${_('The service expiration date is applied as of the payment date and time')}
                </div>
                <div>
                  * ${_('You can only get a refund before the first 7 days')}
                </div>
                <div>
                  * ${_('You cannot pay for a VISA/MASTER card issued in Korea. Please use the Korea payment module')}
                </div>
                <div>
                  % if LANGUAGE_CODE == 'zh':
                    * 付款时贵方视为同意<a href="/policy/service" target="_blank">用户条款</a>
                  % elif LANGUAGE_CODE == 'en':
                    * At payment, you accept <a href="/policy/service" target="_blank">the terms and conditions of the users</a>
                  % else:
                    * 결제 시 귀하는 <a href="/policy/service" target="_blank">이용자 약관</a>과 <a href="/policy/refund" target="_blank">환불 정책</a>에 동의한 것으로 간주합니다
                  % endif
                </div>
            </div>

