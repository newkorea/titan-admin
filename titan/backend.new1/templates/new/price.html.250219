function payment() {
    var pgcode = $('#state_pgcode').val();
    var month_type = $('#state_month_type').val();
    var session = $('#state_session').val();

    console.log('pgcode -> ', pgcode);
    console.log('month_type -> ', month_type);
    console.log('session -> ', session);

    // null 유효성 처리
    if (pgcode == '' || pgcode == null) {
        Swal.fire({
            type: 'error',
            title: '알림',
            text: '결제방식을 선택하십시오',
            confirmButtonColor: swalColor('error'),
        }).then(function(result) { /* pass */ })
        return false;
    } else if (month_type == '' || month_type == null) {
        Swal.fire({
            type: 'error',
            title: '알림',
            text: '상품을 선택하십시오',
            confirmButtonColor: swalColor('error'),
        }).then(function(result) { /* pass */ })
        return false;
    } else if (session == '' || session == null) {
        Swal.fire({
            type: 'error',
            title: '알림',
            text: '세션을 선택하십시오',
            confirmButtonColor: swalColor('error'),
        }).then(function(result) { /* pass */ })
        return false;
    }

    // 결제방식에 따른 분기 처리
    if (pgcode == 'PLCreditCard' || pgcode == 'PLUnionPay' || pgcode == 'PLCreditCardMpi' || pgcode == 'PaypalExpressCheckout') { // 페이레터 해외
        payletter_global(pgcode, month_type, session);
        return false;
    } else if (pgcode == 'WECHAT') { // 엑심베이 (위쳇페이)
        eximbay(pgcode, month_type, session);
        return false;
    } else if (pgcode == 'ALIPAY') { // 엑심베이 (알리페이)
        eximbay(pgcode, month_type, session);
        return false;
    } else if (pgcode == 'WECHAT_deprecated') { // 페이박스 (계약만료)
        // paybox(pgcode, month_type, session);
        return false;
    } else if (pgcode == 'WECHAT_IV') { // 수동
        titan_wechat(pgcode, month_type, session);
        return false;
    } else if (pgcode == 'ALIPAY_IV') { // 수동
        titan_alipay(pgcode, month_type, session);
        return false;
    } else if (pgcode == 'creditcard' || pgcode == 'banktransfer' || pgcode == 'toss' || pgcode == 'kakaopay' || pgcode == 'payco' || pgcode == 'virtualaccount' || pgcode == 'mobile' || pgcode == 'ssgpay') { // 페이레터 국내
        payletter_korea(pgcode, month_type, session);
        return false;
    } else {
        Swal.fire({
            type: 'error',
            title: '알림',
            text: '알수 없는 결제방식 입니다. 관리자에게 문의하십시오',
            confirmButtonColor: swalColor('error'),
        }).then(function(result) { /* pass */ })
    }
}


function payletter_global(pgcode, month_type, session) {
    $.post("/api_make_globalpayletter", {
        csrfmiddlewaretoken: $('#csrf_token').val(),
        pgcode: pgcode,
        session: session,
        month_type: month_type,
    })
    .done(function(data) {
        if (data.result == 'fail') {
            // 이중결제 시도 시 새로고침
            window.location.reload();
        } else {
            var data = data.result;
            console.log('data : ', data);
            console.log('data.backurl : ', data.backurl);
            $('#storeid').val(data.storeid);
            $('#currency').val(data.currency);
            $('#storeorderno').val(data.storeorderno);
            $('#payamt').val(data.payamt);
            $('#payerid').val(data.payerid);
            $('#payeremail').val(data.payeremail);
            $('#servicename').val(data.servicename);
            $('#returnurl').val(data.returnurl);
            $('#backurl').val(data.backurl);
            $('#custom').val(data.custom);
            $('#pginfo').val(data.pginfo);
            $('#recurringtype').val(data.recurringtype);
            $('#timestamp').val(data.timestamp);
            $('#hash').val(data.hash);
            $('#full_url').attr('action', data.full_url);
            $("#full_url").submit();
        }
    });
}

function payletter_korea(pgcode, month_type, session) {
    $.post("/api_make_payletter", {
        csrfmiddlewaretoken: $('#csrf_token').val(),
        pgcode: pgcode,
        session: session,
        month_type: month_type,
    })
    .done(function(data) {
        if (data.result == 'fail') {
            // 이중결제 시도 시 새로고침
            window.location.reload();
        } else {
            window.open(data.result, 'TITAN NETWORKS', 'width=450, height=550');
        }
    });
}


