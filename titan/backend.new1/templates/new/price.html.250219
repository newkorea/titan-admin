    if (month_type == '2' && session == '3') { var price = '336'; }
    if (month_type == '3' && session == '3') { var price = '402'; }
    if (month_type == '6' && session == '3') { var price = '670'; }
    if (month_type == '12' && session == '3') { var price = '1199'; }
    if (month_type == '1' && session == '4') { var price = '198'; }
    if (month_type == '2' && session == '4') { var price = '396'; }
    if (month_type == '3' && session == '4') { var price = '510'; }
    if (month_type == '6' && session == '4') { var price = '790'; }
    if (month_type == '12' && session == '4') { var price = '1420'; }
    if (month_type == '1' && session == '5') { var price = '259'; }
    if (month_type == '2' && session == '5') { var price = '518'; }
    if (month_type == '3' && session == '5') { var price = '649'; }
    if (month_type == '6' && session == '5') { var price = '1050'; }
    if (month_type == '12' && session == '5') { var price = '1890'; }
    if (month_type == '1' && session == '6') { var price = '328'; }
    if (month_type == '2' && session == '6') { var price = '656'; }
    if (month_type == '3' && session == '6') { var price = '718'; }
    if (month_type == '6' && session == '6') { var price = '1330'; }
    if (month_type == '12' && session == '6') { var price = '2380'; }

    $.post("/api_plz_payment", {
        csrfmiddlewaretoken: $('#csrf_token').val(),
        pgcode: pgcode,
        session: session,
        month_type: month_type,
        type: 'W',
    })
    .done(function(data) {
        if (data.result == '300') {    
            var payMethod = "알리페이";
            if (data.data.type == 'W') {
                payMethod = "위쳇페이";
            }
		    Swal.fire({
		        html:
				'<div style="margin-top: 14px;">위쳇페이WECHAT</div>'+
		        '<div style="font-weight: bold; font-size: 30px;">'+price+' 元</div>'+
		        '<img style="width: 250px; height: 250px;" src='+srcaddress+'>'+
		        '<div style="margin-top: 15px; font-size: 16px;;color:red;">이미 예전에 신청하신 상품을 처리중에 있습니다.  </div>'+
		        '<div style="font-size: 16px;color:blue;margin-top:10px;"><label><strong>주문번호:</strong></label> '+ data.data.id + 
		        '  상품:' + data.data.session + '세션 '+ data.data.month_type +'개월 </div>'+
		        '<div style="font-size: 16px;color:blue;margin-bottom:10px;">지불방법:' + payMethod + ' <strong>요청시간:</strong>' + data.data.regist_date + '</div>'+
		        '<div style="font-size: 16px;;color:red;">만약 이미 입금하셨는데 처리가 안되었다면 취소버튼을 눌러 나오는 아래상담하기를 눌러 관리자에게 알려주세요.</div>'+
				'<div style="font-size: 16px;;color:blue;">만약 예전 신청내용을 취소하고 다시 지불하시려면 위 QR로</div>'+
				'<div style="font-weight: bold; font-size: 26px;">'+price+' 元</div>'+
				'<div style="font-size: 16px;;color:blue;">입금 후 다시신청버튼을 눌러 나오는 채널톡으로 입금했음을 알려주세요.</div>',        
	        
		        showCancelButton: true,
		        showConfirmButton: true,
		        confirmButtonColor: '#8a4cf7',
		        cancelButtonColor: '#cccccc',
		        confirmButtonText: '다시신청',
		        cancelButtonText: '상담하기',
		        reverseButtons: true,
		        allowOutsideClick: false,
		    }).then(function(result) {
		        if (result.value) {
			        $.post("/api_create_payment", {
				        csrfmiddlewaretoken: $('#csrf_token').val(),
				        pgcode: pgcode,
				        session: session,
				        month_type: month_type,
				        type: 'W',
				        create_type: 'F',
				    })
				    .done(function(data) {
				        if (data.result == '200') {
                            window.open('https://titan.channel.io', '_blank');
						}
				    });
			    } else {
                    window.open('https://titan.channel.io', '_blank');
			    }
		    })
        } else {
		    Swal.fire({
		        html:
				'<div style="margin-top: 14px;">위쳇페이WECHAT</div>'+
	            '<div style="font-weight: bold; font-size: 30px;">'+price+'元</div>'+
		        '<img style="width: 250px; height: 250px;" src='+srcaddress+'>'+
		        '<div style="margin-top: 15px; font-size: 16px;;color:red;">위챗입금을 신청하셨습니다.</div>'+
		        '<div style="font-size: 16px;;color:red;">위챗으로 위 QR코드를 스캔하여 금액 '+price+' 元을 입금하여주세요. </div>'+
		        '<div style="margin-top: 15px; font-size: 16px;color:blue;">위 QR CODE로 입금하신 후 수동으로 관리자가 확인 결제처리합니다</div>'+
		        '<div style="font-size: 16px;color:blue;">결제후 확인버튼을 눌러 나오는 채널톡상담하기로 관리자에게 알려주세요.</div>',
		        showCancelButton: true,
		        showConfirmButton: true,
		        confirmButtonColor: '#8a4cf7',
		        cancelButtonColor: '#cccccc',
		        confirmButtonText: '신청',
		        cancelButtonText: '취소',
		        reverseButtons: true,
		        allowOutsideClick: false,
		    }).then(function(result) {
		        if (result.value) {
			        $.post("/api_create_payment", {
				        csrfmiddlewaretoken: $('#csrf_token').val(),
				        pgcode: pgcode,
				        session: session,
				        month_type: month_type,
				        type: 'W',
				        create_type: 'C',
				    })
				    .done(function(data) {
				        if (data.result == '200') {
                            window.open('https://titan.channel.io', '_blank');
						}
				    });
				 }
		    })
        }
    });
}


