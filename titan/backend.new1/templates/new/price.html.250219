function titan_wechat(pgcode, month_type, session) {
    var srcaddress = "/static/new/img/payment_core/weixin.png"
    if (month_type == '1' && session == '1') { var price = '69'; }
    if (month_type == '2' && session == '1') { var price = '138'; }
    if (month_type == '3' && session == '1') { var price = '147'; }
    if (month_type == '6' && session == '1') { var price = '280'; }
    if (month_type == '12' && session == '1') { var price = '490'; }
    if (month_type == '1' && session == '2') { var price = '99'; }
    if (month_type == '2' && session == '2') { var price = '198'; }
    if (month_type == '3' && session == '2') { var price = '255'; }
    if (month_type == '6' && session == '2') { var price = '399'; }
    if (month_type == '12' && session == '2') { var price = '720'; }
