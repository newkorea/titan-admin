                </div>
                <div class="col-md-12 col-sm-12 col-lg-12" style="margin-bottom: 3px !important">
                    <div class="testimonial-quote-wrap p-gab rounded white-bg shadow-sm hackx" style="min-height: 76px;" id="2">
                        <div class="media author-info ref-box">
                            <div class="author-img mr-3">
                                <img src="/static/new/img/product/one6.png" alt="client" class="img-fluid rounded-circle ref-img">
                            </div>
                            <div class="media-body">
