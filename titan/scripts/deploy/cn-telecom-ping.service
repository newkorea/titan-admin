[Unit]
Description=TitanVPN CN Telecom Ping Measurement
After=network.target

[Service]
Type=oneshot
User=newkorea
WorkingDirectory=/home/newkorea/project/titan
ExecStart=/home/newkorea/project/titan/.venv310/bin/python3 scripts/cn_telecom_ping.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
