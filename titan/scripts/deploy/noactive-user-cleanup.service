[Unit]
Description=TitanVPN Noactive User Cleanup
After=network.target

[Service]
Type=oneshot
User=newkorea
WorkingDirectory=/home/newkorea/project/titan
ExecStart=/home/newkorea/project/titan/.venv310/bin/python3 scripts/noactive_user_cleanup.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
