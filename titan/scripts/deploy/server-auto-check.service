[Unit]
Description=TitanVPN Server Auto Check (Auto-disable unhealthy servers)
After=network.target

[Service]
Type=oneshot
User=newkorea
WorkingDirectory=/home/newkorea/project/titan
ExecStart=/home/newkorea/project/titan/.venv310/bin/python3 scripts/server_auto_check.py
TimeoutStartSec=300
StandardOutput=journal
StandardError=journal
