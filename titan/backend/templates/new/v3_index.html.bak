<script>
// Server filter
function filterServers(isp) {
  document.querySelectorAll('.server-tab').forEach(t => t.classList.remove('active'));
  event.target.classList.add('active');
  document.querySelectorAll('.server-card').forEach(c => {
    c.style.display = (isp === 'all' || c.dataset.isp === isp) ? '' : 'none';
  });
}
// FAQ toggle
document.querySelectorAll('.faq-q').forEach(q => {
  q.addEventListener('click', () => q.parentElement.classList.toggle('open'));
});
// Phone power button toggle
var connected = false;
document.getElementById('powerBtn').addEventListener('click', function() {
  connected = !connected;
  var ring = this;
  var icon = ring.querySelector('.power-icon');
  var status = document.getElementById('connStatus');
  if (connected) {
    ring.style.borderColor = '#10b981';
    ring.style.boxShadow = '0 4px 32px rgba(16,185,129,0.3)';
    icon.style.color = '#10b981';
    status.style.color = '#10b981';
    status.textContent = '연결됨';
  } else {
    ring.style.borderColor = '#e8b4b8';
    ring.style.boxShadow = '0 4px 24px rgba(200,100,120,0.15)';
    icon.style.color = '#e07080';
    status.style.color = '#e05060';
    status.textContent = '연결안됨';
  }
});
// Protocol checkbox toggle
document.querySelectorAll('.ph-proto-item').forEach(item => {
  item.addEventListener('click', function() {
    var chk = this.querySelector('.proto-check');
    chk.classList.toggle('on');
    chk.textContent = chk.classList.contains('on') ? '✓' : '';
  });
});
</script>
</body>
</html>
