<%! from django.utils.translation import ugettext as _ %>
<%inherit file="base.html"/>

<%block name="css">
</%block>

<%block name="content">
<!--body content wrap start-->
<div class="main">

    <!--hero section start-->
    <section class="hero-section ptb-100 background-img"
             style="background: url('/static/new/img/hero-bg-1.jpg')no-repeat center center / cover; padding-bottom: 30px !important;">
        <div class="container">
            <div class="row align-items-center justify-content-center">
                <div class="col-md-9 col-lg-7">
                    <div class="page-header-content text-white text-center pt-sm-5 pt-md-5 pt-lg-0">
                        <h1 class="text-white mb-0">${_('The price at a glance')}</h1>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!--hero section end-->

    <!--contact us section start-->
    <section class="contact-us gray-light-bg ptb-100">
        <div class="container">
            <div class="row">
                <span class="badge badge-success badge-pill mb-8">${_('One user concurrent access')}</span>
                <table class="table table-bordered see-table">
                    <thead class="thead-light">
                        <tr>
                            <th>${_('Service period')}</th>
                            <th>${_('WON')}</th>
                            <th>${_('USD')}</th>
                            <th>${_('CNY')}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1 ${_('Month')}${_('(30days)')}</td>
                            <td>￦8,300 </td>
                            <td>$7 </td>
                            <td>¥49 </td>
                        </tr>
                        <tr>
                            <td>6 ${_('Month')}${_('(180days)')}</td>
                            <td>￦47,000 </td>
                            <td>$40 </td>
                            <td>¥280 </td>
                        </tr>
                        <tr>
                            <td>12 ${_('Month')}${_('(360days)')}</td>
                            <td>￦83,000 </td>
                            <td>$70 </td>
                            <td>¥490 </td>
                        </tr>
                    </tbody>
                </table>
                <span class="badge badge-success badge-pill mb-8">${_('2 usres concurrent access')}</span>
                <table class="table table-bordered see-table">
                    <thead class="thead-light">
                        <tr>
                            <th>${_('Service period')}</th>
                            <th>${_('WON')}</th>
                            <th>${_('USD')}</th>
                            <th>${_('CNY')}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>1 ${_('Month')}${_('(30days)')}</td>
                            <td>￦14,000 </td>
                            <td>$12 </td>
                            <td>¥85 </td>
                        </tr>
                        <tr>
                            <td>6 ${_('Month')}${_('(180days)')}</td>
                            <td>￦69,000 </td>
                            <td>$58 </td>
                            <td>¥399 </td>
                        </tr>
                        <tr>
                            <td>12 ${_('Month')}${_('(360days)')}</td>
                            <td>￦125,000 </td>
                            <td>$105 </td>
                            <td>¥720 </td>
                        </tr>
                    </tbody>
                </table>

                <div style="width: 100%;">
                    <a href="#" onclick="history.back()">
                        ${_('Go back')}
                    <a>
                    <a style="float: right;" href="/price">
                        ${_('Move to payment page')}
                    <a>
                </div>
            </div>
        </div>
    </section>
    <!--contact us section end-->

</div>
<!--body content wrap end-->
</%block>

<%block name="js">
</%block>
