    print('INFO -> login_password : ', login_password)
    print('INFO -> login_ip : ', login_ip)

    # 백엔드 유효성 체크
    if login_email == '':
        return JsonResponse({'result': 400})
    elif login_password == '':
        return JsonResponse({'result': 400})

